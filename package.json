{
  "name": "catcard-sdk",
  "version": "0.1.0",
  "description": "JavaScript SDK for CatCard hardware wallets: air-gapped communication over BBQr and BC-UR QR codes",
  "keywords": [
    "catcard",
    "hardware-wallet",
    "airgap",
    "qr",
    "bbqr",
    "bc-ur",
    "psbt",
    "bitcoin",
    "ethereum",
    "evm",
    "eip-1193",
    "eip-6963",
    "solana",
    "wallet-standard",
    "tron",
    "tip-1193",
    "tip-6963",
    "sats-connect",
    "wbip",
    "bitcoin-wallet-standard"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/auto.js",
    "./dist/auto.cjs",
    "./dist/catcard-inject.iife.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./evm": {
      "import": {
        "types": "./dist/evm.d.ts",
        "default": "./dist/evm.js"
      },
      "require": {
        "types": "./dist/evm.d.cts",
        "default": "./dist/evm.cjs"
      }
    },
    "./solana": {
      "import": {
        "types": "./dist/solana.d.ts",
        "default": "./dist/solana.js"
      },
      "require": {
        "types": "./dist/solana.d.cts",
        "default": "./dist/solana.cjs"
      }
    },
    "./tron": {
      "import": {
        "types": "./dist/tron.d.ts",
        "default": "./dist/tron.js"
      },
      "require": {
        "types": "./dist/tron.d.cts",
        "default": "./dist/tron.cjs"
      }
    },
    "./bitcoin": {
      "import": {
        "types": "./dist/bitcoin.d.ts",
        "default": "./dist/bitcoin.js"
      },
      "require": {
        "types": "./dist/bitcoin.d.cts",
        "default": "./dist/bitcoin.cjs"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/ui.d.ts",
        "default": "./dist/ui.js"
      },
      "require": {
        "types": "./dist/ui.d.cts",
        "default": "./dist/ui.cjs"
      }
    },
    "./inject": {
      "import": {
        "types": "./dist/inject.d.ts",
        "default": "./dist/inject.js"
      },
      "require": {
        "types": "./dist/inject.d.cts",
        "default": "./dist/inject.cjs"
      }
    },
    "./auto": {
      "import": {
        "types": "./dist/auto.d.ts",
        "default": "./dist/auto.js"
      },
      "require": {
        "types": "./dist/auto.d.cts",
        "default": "./dist/auto.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/catcard.iife.js",
  "jsdelivr": "./dist/catcard.iife.js",
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:pkg": "publint",
    "check": "npm run typecheck && npm run test && npm run build && npm run lint:pkg",
    "prepublishOnly": "npm run check",
    "icon": "node scripts/build-icon.mjs"
  },
  "dependencies": {
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.5",
    "@scure/bip32": "^1.7.0",
    "@scure/btc-signer": "^1.8.1",
    "@solana/wallet-standard-features": "^1.5.0",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "@wallet-standard/wallet": "^1.1.1",
    "jsqr": "^1.4.0",
    "pako": "^2.2.0",
    "uqr": "^0.1.3",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@keystonehq/bc-ur-registry": "^0.8.0",
    "@keystonehq/bc-ur-registry-btc": "^0.1.1",
    "@keystonehq/bc-ur-registry-eth": "^0.22.1",
    "@keystonehq/bc-ur-registry-sol": "^0.9.5",
    "@ngraveio/bc-ur": "^1.1.13",
    "@solana/web3.js": "^1.99.0",
    "@types/node": "^26.6.2",
    "@types/pako": "^2.0.4",
    "bbqr": "^1.2.0",
    "happy-dom": "^20.14.5",
    "publint": "^0.3.24",
    "tronweb": "^6.5.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "tronweb": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "tronweb": {
      "optional": true
    }
  }
}
